# Neon Postgres Database URL (Singapore ap-southeast-1, pooled connection)
DATABASE_URL=

# Google OAuth & Drive API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Drive Shared Root Folder ID
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Admin Email (automatically assigned role: 'admin')
ADMIN_EMAIL=

# Additional Allowed Emails (comma-separated, role: 'member')
ALLOWED_EMAILS=

# Session Secret (32+ characters for jose AES-256-GCM encryption)
SESSION_SECRET=

# App URL
APP_URL=
